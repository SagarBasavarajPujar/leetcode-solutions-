class Solution(object):
    def minSubArrayLen(self, target, nums):

        l=0
        current_sum=0
        min_len=float("inf")

        for r in range(len(nums)):
            current_sum+=nums[r]

            while current_sum>=target :
                min_len=min(min_len,r-l+1)
                current_sum-=nums[l]
                l+=1

            r+=1
        return min_len if min_len!=float("inf") else 0


        